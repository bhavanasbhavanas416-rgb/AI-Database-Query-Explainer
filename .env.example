# Django Core Production Settings
SECRET_KEY=your-production-super-secret-key-change-this-in-prod
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com,.railway.app,.run.app,.herokuapp.com

# Security & CORS Settings
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.railway.app,https://*.run.app,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SECURE_SSL_REDIRECT=False

# Groq AI Model Credentials
GROQ_API_KEY=gsk_your_groq_api_key_here

# Database Configuration (PostgreSQL / MySQL for Production, SQLite for Dev fallback)
# Example PostgreSQL URL: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# Server Port (Injected automatically by cloud providers like Cloud Run, Heroku, Render)
PORT=8000
